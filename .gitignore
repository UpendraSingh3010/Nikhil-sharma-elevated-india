# =========================================================
# GoCommercially React App .gitignore
# Excludes dependencies, build artifacts, environments, and unused files
# =========================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/

# Vercel Deployment Cache
.vercel/

# Environment Variables & Secrets (NEVER SHARE ON GIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
*.env
!.env.example

# Debug & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Temporary Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Unused Template & Boilerplate Assets (Not used in production)
src/App.css
src/data_mega.js
src/assets/hero.png
src/assets/react.svg
src/assets/vite.svg
